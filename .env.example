# Copy this file to .env and replace the key. The real .env is git-ignored.
# DeepSeek handles answer generation; the built-in hash embedding needs no key.
OPENAI_API_KEY=replace-with-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
RAG_MODEL=deepseek-flash
RAG_EMBEDDING=hash
RAG_GENERATOR=openai
RAG_DB=data/deepseek.db

# To use a real OpenAI-compatible embedding provider, change
# RAG_EMBEDDING=openai and uncomment/configure these three lines:
# EMBEDDING_API_KEY=replace-with-your-embedding-key
# EMBEDDING_BASE_URL=https://embedding-provider.example/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BATCH_SIZE=20
